<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/ui_accent</item>
        <item name="android:colorControlActivated">@color/ui_accent</item>
        <item name="android:textColorPrimary">@color/ui_text</item>
        <item name="android:textColorSecondary">@color/ui_muted</item>
        <item name="android:windowBackground">@color/ui_canvas</item>
        <item name="android:navigationBarColor">@color/ui_canvas</item>
        <item name="android:statusBarColor">@color/ui_canvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorBackgroundFloating">@color/ui_surface</item>
        <item name="android:windowActionModeOverlay">true</item>
